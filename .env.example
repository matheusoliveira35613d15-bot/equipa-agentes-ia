GEMINI_API_KEY=coloque_aqui_a_sua_chave
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_REVIEW_ITERATIONS=3

# Opcional: só preencha se publicar a app online (ex: Render/Railway). Ativa um sistema de
# contas (login + criar conta) — sem isto a app fica aberta, como em uso local.
#
# REGISTO_CHAVE: chave secreta que tem de ser indicada para criar uma conta nova. Escolha algo
# longo e difícil de adivinhar, e só partilhe com quem quer convidar.
REGISTO_CHAVE=
#
# SECRET_KEY: usada para assinar a sessão de login (não é a chave de registo). Se não definir,
# a app gera uma automaticamente, mas isso faz com que todos tenham de voltar a fazer login
# sempre que o serviço reiniciar — defina um valor fixo se publicar online.
SECRET_KEY=

# Opcional: pasta onde ficam os projetos e as contas (workspaces/ e data/users.json). Por
# omissão é a própria pasta do projeto. Só precisa de mudar se tiver um disco persistente
# montado noutro sítio (ex: um Volume do Fly.io) e quiser guardar os dados lá.
DATA_DIR=
